# Copy this file to .env.local and fill it in. Leave everything empty to run in demo-only mode.
# Never commit .env.local: it holds secrets.

# Accounts also need this switch set to true. With it unset, the site is demo-only even if the keys below are filled in.
VITE_ENABLE_ACCOUNTS=

# Supabase → Project Settings → API (exposed to the browser, VITE_ prefix required)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only (Vercel functions in /api). Never exposed to the browser.
# Same values as above, read by the API to verify the signed-in user:
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Supabase → Connect → Transaction pooler (port 6543, host ends in pooler.supabase.com)
DATABASE_URL=
