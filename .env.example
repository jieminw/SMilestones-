# Copy to .env.local. Leave empty to run in demo-only mode.

# Supabase → Project Settings → API (exposed to the browser, VITE_ prefix required)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only (Vercel functions in /api). Never exposed to the browser.
# Same values as above, read by the API to verify the signed-in user:
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Supabase → Connect → Transaction pooler (port 6543)
DATABASE_URL=
